# ==========================================
# GBP REVIEW MANAGER - DOKPLOY ENVIRONMENT
# ==========================================

# Groq API Key for AI review suggestions and auto-replies
GROQ_API_KEY=gsk_your_groq_api_key_here

# Super Admin Dashboard Password
ADMIN_PASSWORD=your_secure_admin_password_here

# Flask Secret Key for secure sessions
SECRET_KEY=generate_a_random_32_byte_secret_here

# PostgreSQL Database URL
# If left empty, SQLite (gbp.db) is used locally.
# On Dokploy, connect your Postgres service using internal or external connection string:
# DATABASE_URL=postgresql://postgres:password@postgres:5432/gbp_db
DATABASE_URL=

# Port to bind (Dokploy default is 5000)
PORT=5000
